# Copia este archivo como .env EN LA MAQUINA VIRTUAL (nunca lo subas a git) y completa los valores.

# Dominio que apunta a la IP publica de la maquina (p. ej. academiapass.duckdns.org). Caddy saca el certificado HTTPS
DOMAIN=

# Cadena de conexion de Neon (postgresql://...?sslmode=require)
DATABASE_URL=
# Clave larga y aleatoria para firmar sesiones y QR. instalar.sh la genera si queda vacia
JWT_SECRET=
APP_TIMEZONE=America/Bogota
NODE_ENV=production

# RQ67: correos desde tu Gmail (sin servidor de correo). Opcion A (PC local o servidor que permita SMTP):
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcion B (cualquier servidor, tambien Render free): API de Gmail con OAuth (ver docs/CORREO_GMAIL.md)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# URL publica para los enlaces de los correos (p. ej. https://academiapass.onrender.com); vacio = la del servidor
PUBLIC_URL=
# O un servicio de correos: clave de Resend (o BREVO_API_KEY) y remitente de un dominio verificado en Resend
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=AcademiaPass <avisos@tu-dominio.com>

# Opcional: si se define, registrar una organizacion exige este codigo
ADMIN_SIGNUP_CODE=
