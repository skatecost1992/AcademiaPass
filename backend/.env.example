# Copia este archivo como .env solo como referencia: la API lee variables de entorno del sistema.

# PostgreSQL en la nube (Render, Neon, Supabase...). Vacío = PGlite local en ./.data/pglite (en producción es obligatoria)
DATABASE_URL=
# Clave del usuario base "admin" (administrador general); solo se usa al crearlo. Vacía = se genera una al azar
# y se muestra una sola vez en el registro (log) del servidor
ADMIN_INITIAL_PASSWORD=
# "off" si la base no usa SSL (conexión interna de Render o PostgreSQL local)
PGSSL=
# Obligatorio en producción: firma de sesiones y códigos QR
JWT_SECRET=
# Zona horaria para horarios de atención y reportes semanales/mensuales
APP_TIMEZONE=America/Bogota
# Opcional: si se define, registrar una organización exige este código
ADMIN_SIGNUP_CODE=
# Opcional: orígenes permitidos para CORS separados por coma (vacío = todos)
CORS_ORIGIN=
PORT=8080
# RQ67: correos desde tu Gmail (sin servidor de correo). Opcion A (PC local o servidor que permita SMTP):
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcion B (cualquier servidor, tambien Render free): API de Gmail con OAuth (ver docs/CORREO_GMAIL.md)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# URL publica para los enlaces de los correos (p. ej. https://academiapass.onrender.com); vacio = la del servidor
PUBLIC_URL=
# Correos de recordatorio y vencimiento de plan (RQ63, RQ64). Prioridad: Resend, Brevo, SMTP. Sin ninguno solo se registran
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
