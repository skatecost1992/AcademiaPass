{
  "expo": {
    "name": "AcademiaPass",
    "slug": "academiapass-ios",
    "scheme": "academiapass",
    "version": "1.0.8",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F1F5F4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AcademiaPass usa la cámara para leer el código QR de los clientes y tomar fotos de sedes y espacios.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AcademiaPass necesita tus fotos para cargar imágenes de sedes y espacios.",
          "cameraPermission": "AcademiaPass usa la cámara para tomar fotos de sedes y espacios."
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "apiUrlCloud": "https://academiapass.onrender.com",
      "apiUrlLocal": "http://192.168.1.173:8080",
      "defaultServer": "cloud",
      "cloudDatabase": "PostgreSQL en Neon · ep-patient-night-b4jrwjmw-pooler.c-6.us-east-2.aws.neon.tech",
      "localDatabase": "SQL Server · DESKTOP-FODDHQ6 / AcademiaPass"
    },
    "ios": {
      "bundleIdentifier": "com.cristhianhernandez.academiapass",
      "buildNumber": "9",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "AcademiaPass usa la cámara para leer el código QR de los clientes y tomar fotos de sedes y espacios.",
        "NSPhotoLibraryUsageDescription": "AcademiaPass necesita tus fotos para cargar imágenes de sedes y espacios."
      }
    }
  }
}
