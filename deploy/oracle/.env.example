# Copia este archivo como .env EN LA MAQUINA VIRTUAL (nunca lo subas a git) y completa los valores.

# Dominio que apunta a la IP publica de la maquina (p. ej. academiapass.duckdns.org). Caddy saca el certificado HTTPS
DOMAIN=

# Cadena de conexion de Neon (postgresql://...?sslmode=require)
DATABASE_URL=
# Clave larga y aleatoria para firmar sesiones y QR. instalar.sh la genera si queda vacia
JWT_SECRET=
APP_TIMEZONE=America/Bogota
NODE_ENV=production

# Correos (RQ63, RQ64): clave de Resend (o BREVO_API_KEY) y remitente de un dominio verificado en Resend
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=AcademiaPass <avisos@tu-dominio.com>

# Opcional: si se define, registrar una organizacion exige este codigo
ADMIN_SIGNUP_CODE=
