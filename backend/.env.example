# Copia este archivo como .env solo como referencia: la API lee variables de entorno del sistema.

# PostgreSQL en la nube (Render, Neon, Supabase...). Vacío = PGlite local en ./.data/pglite
DATABASE_URL=
# "off" si la base no usa SSL (conexión interna de Render o PostgreSQL local)
PGSSL=
# Obligatorio en producción: firma de sesiones y códigos QR
JWT_SECRET=
# Zona horaria para horarios de atención y reportes semanales/mensuales
APP_TIMEZONE=America/Bogota
# Opcional: si se define, registrar una organización exige este código
ADMIN_SIGNUP_CODE=
# Opcional: orígenes permitidos para CORS separados por coma (vacío = todos)
CORS_ORIGIN=
PORT=8080
# Correos de recordatorio y vencimiento de plan (RQ63, RQ64). Sin SMTP_HOST solo se registran
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
